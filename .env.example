# TASKORA Environment Configuration
PORT=3000
NODE_ENV=development

# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret for session authentication & Socket.IO handshake
JWT_SECRET=taskora_jwt_secret_dev_key_2026_super_secure_change_in_production
